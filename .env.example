# CraftLens Environment Configuration

# Backend Server Port
PORT=5000

# Teammate Voice Model Endpoint (faster-whisper + LLM extractor service)
# Default: http://127.0.0.1:8000/api/voice/process
VOICE_MODEL_ENDPOINT=http://127.0.0.1:8000/api/voice/process

# Teammate Model Host (if running via Ollama)
# OLLAMA_HOST=http://localhost:11434

# Frontend API Base URL (optional - Vite dev server proxies /api to http://localhost:5000)
# VITE_API_BASE=http://localhost:5000/api
